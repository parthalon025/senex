# senex.config.toml.example — sample config copied from spec §6.

[output]
root              = "E:/senex-audits"
filename_template = "{repo}/{date}-{run_id_short}"
redact_secrets    = true
retention_days    = 0

[lens]
name             = "correctness"
min_priority     = "all"
include_tests    = false

[walker]
max_size_bytes        = 524288
extensions            = [".py", ".ts", ".tsx", ".js", ".jsx", ".go", ".rs", ".java", ".kt", ".cs", ".cpp", ".c", ".h", ".hpp", ".swift", ".rb", ".php", ".sh", ".ps1", ".scala", ".ex", ".exs", ".dart", ".lua", ".zig", ".nim"]
default_excludes      = ["node_modules", ".venv", "venv", "dist", "build", "__pycache__", "*.min.*", ".git", "vendor"]
respect_gitignore     = true
include_tests         = false

[crosscut]
top_n_high   = 50
top_n_medium = 100
top_n_low    = 100

[lmstudio]
base_url           = "http://localhost:1234/v1"
api_key            = "lm-studio"
connect_timeout    = 10
read_timeout       = 600
http_retries       = 3
backoff_seconds    = [5, 15, 45]
model              = "google/gemma-4-26b-a4b"
preset             = ""
allow_non_loopback = false

[lmstudio.sampling]
temperature       = 0.6
top_p             = 0.95
top_k             = 40
min_p             = 0.0
repeat_penalty    = 1.0
frequency_penalty = 0.0
presence_penalty  = 0.0
seed              = 42
seed_random       = true
max_tokens        = 8192
stop              = []

[lmstudio.thinking]
enabled              = true
effort               = "high"
max_thinking_tokens  = 32768
save_traces          = true
include_in_report    = false

[lmstudio.tasks.file_audit]
temperature = 0.6
max_tokens  = 8192

[lmstudio.tasks.cross_cutting]
temperature = 0.7
max_tokens  = 4096

[lmstudio.tools]
enabled              = true
max_calls_per_file   = 5
max_result_tokens    = 2048
tool_timeout_seconds = 30

[lmstudio.compaction]
enabled                  = true
trigger_pct              = 0.80
target_pct               = 0.50
preserve_recent_turns    = 2
max_compactions_per_file = 3

[lmstudio.lifecycle]
auto_load            = true
auto_unload          = true
load_timeout_seconds = 120
runlock_dir          = ""

# Repo entries (nightly iterates these; ad-hoc may target any repo by path)
[[repos]]
name                     = "pensiv"
path                     = "E:/pensiv"
system_prompt_addendum   = ".claude/CLAUDE.md"
include_extensions       = []
exclude_globs            = ["src/pensiv/_archive/**"]
include_tests            = false
lmstudio = { tasks = { file_audit = { temperature = 0.5 } } }
