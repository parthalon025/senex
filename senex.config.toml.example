# senex.config.toml.example — sample config copied from spec §6.

[output]
root              = "E:/senex-audits"
filename_template = "{repo}/{date}-{run_id_short}"
redact_secrets    = true
retention_days    = 0

[lens]
name             = "correctness"
min_priority     = "all"
include_tests    = false

[walker]
max_size_bytes        = 524288
max_files             = 50000
extensions            = [".py", ".ts", ".tsx", ".js", ".jsx", ".go", ".rs", ".java", ".kt", ".cs", ".cpp", ".c", ".h", ".hpp", ".swift", ".rb", ".php", ".sh", ".ps1", ".scala", ".ex", ".exs", ".dart", ".lua", ".zig", ".nim"]
default_excludes      = ["node_modules", ".venv", "venv", "dist", "build", "__pycache__", "*.min.*", ".git", "vendor"]
respect_gitignore     = true
scan_subdir           = ""
include_tests         = false

[crosscut]
top_n_high   = 50
top_n_medium = 100
top_n_low    = 100

[lmstudio]
# Inference-server endpoint. Defaults match SGLang's compose stack
# (http://localhost:30000/v1). For LM Studio, set base_url to
# "http://localhost:1234/v1" and pick a model id served by `lms ls`.
base_url           = "http://localhost:30000/v1"
api_key            = "lm-studio"
connect_timeout    = 10
read_timeout       = 600
http_retries       = 3
backoff_seconds    = [5, 15, 45]
model              = "google/gemma-4-E4B-it"
preset             = ""
allow_non_loopback = false
# If true, use OpenAI-compat 'json_schema' response_format strictly. SGLang
# honors strict JSON schema natively, so this defaults to true. Set false
# only when targeting backends that do not support strict schema (e.g.
# older LM Studio + Gemma combinations).
strict_json_schema = true

[lmstudio.sampling]
temperature       = 0.6
top_p             = 0.95
top_k             = 40
min_p             = 0.0
repeat_penalty    = 1.0
frequency_penalty = 0.0
presence_penalty  = 0.0
seed              = 42
seed_random       = true
max_tokens        = 8192
stop              = []

[lmstudio.thinking]
enabled              = true
effort               = "high"
max_thinking_tokens  = 32768
save_traces          = true
include_in_report    = false

[lmstudio.tasks.file_audit]
temperature = 0.6
max_tokens  = 8192

[lmstudio.tasks.cross_cutting]
temperature = 0.7
max_tokens  = 4096

[lmstudio.tools]
enabled              = true
max_calls_per_file   = 5
max_result_tokens    = 2048
tool_timeout_seconds = 30

[lmstudio.compaction]
enabled                  = true
trigger_pct              = 0.80
target_pct               = 0.50
preserve_recent_turns    = 2
max_compactions_per_file = 3

[lmstudio.lifecycle]
auto_load                       = true
auto_unload                     = true
load_timeout_seconds            = 120     # auto_load subprocess timeout
load_wait_timeout_seconds       = 600     # max wait for manual load on auto_load failure (0 = disable)
load_wait_poll_interval_seconds = 5.0     # is_loaded poll cadence during wait
runlock_dir                     = ""

# [lmstudio.sglang] — SGLang Docker container management (only applies when
# the configured base_url is served by a senex-managed SGLang stack). When
# manage_container=true, senex runs `docker compose up -d` at audit start and
# `down` at audit completion ("load on startup, shutdown on completion").
# Leave manage_container=false to keep the container running between runs
# (the default — bring it up manually via `bash infra/sglang/sglang.sh up`).
[lmstudio.sglang]
manage_container        = false
compose_file            = "infra/sglang/docker-compose.yml"
env_file                = "infra/sglang/.env"
startup_timeout_seconds = 180
via_wsl                 = true
wsl_distro              = "Ubuntu"

# [ui] — Launcher / TUI surface settings (M11).
# Drives the "Scan disk for repos" button on the Launcher screen.
# Both keys are commented out below so the defaults apply: scan_root falls
# back to the user's home directory at runtime, and scan_max_depth caps the
# recursive walk so a large home tree stays responsive.
[ui]
# scan_root      = "E:/code"
# scan_max_depth = 6

# Repo entries (nightly iterates these; ad-hoc may target any repo by path)
[[repos]]
name                     = "pensiv"
path                     = "E:/pensiv"
system_prompt_addendum   = ".claude/CLAUDE.md"
include_extensions       = []
exclude_globs            = ["src/pensiv/_archive/**"]
include_tests            = false
lmstudio = { tasks = { file_audit = { temperature = 0.5 } } }
