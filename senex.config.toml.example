# senex.config.toml.example — sample config copied from spec §6.

# [output] — where audit run dirs are written.
# ``root`` defaults to ``<user-home>/senex-audits`` if omitted (the value below
# is shown for clarity). Set an absolute path to override. senex does not prune
# old run directories; users are responsible for retention per their own policy.
[output]
# root              = "/home/youruser/senex-audits"
filename_template = "{repo}/{date}-{run_id_short}"
redact_secrets    = true
retention_days    = 0  # 0 = retain forever; future versions may auto-prune

[lens]
name             = "correctness"
min_priority     = "all"
include_tests    = false

[walker]
max_size_bytes        = 524288
max_files             = 50000
extensions            = [".py", ".ts", ".tsx", ".js", ".jsx", ".go", ".rs", ".java", ".kt", ".cs", ".cpp", ".c", ".h", ".hpp", ".swift", ".rb", ".php", ".sh", ".ps1", ".scala", ".ex", ".exs", ".dart", ".lua", ".zig", ".nim"]
default_excludes      = ["node_modules", ".venv", "venv", "dist", "build", "__pycache__", "*.min.*", ".git", "vendor"]
respect_gitignore     = true
scan_subdir           = ""
include_tests         = false

[crosscut]
top_n_high   = 50
top_n_medium = 100
top_n_low    = 100

[inference]
# Inference-server endpoint. Defaults match SGLang's compose stack
# (http://localhost:30000/v1). For Ollama, use base_url = "http://localhost:11434/v1"
# and set backend = "ollama". Auto-detection order: Ollama (if reachable) → SGLang.
backend            = "auto"   # "ollama" | "sglang" | "auto"
base_url           = "http://localhost:30000/v1"
api_key            = "lm-studio"
connect_timeout    = 10
read_timeout       = 600
http_retries       = 3
backoff_seconds    = [5, 15, 45]
model              = "google/gemma-4-E4B-it"
preset             = ""
allow_non_loopback = false
# If true, use OpenAI-compat 'json_schema' response_format strictly. SGLang
# honors strict JSON schema natively, so this defaults to true. Set false
# only when targeting backends that do not support strict schema.
strict_json_schema = true

[inference.sampling]
temperature       = 0.6
top_p             = 0.95
top_k             = 40
min_p             = 0.0
repeat_penalty    = 1.0
frequency_penalty = 0.0
presence_penalty  = 0.0
seed              = 42
seed_random       = true
max_tokens        = 8192
stop              = []

[inference.thinking]
enabled              = true
effort               = "high"
max_thinking_tokens  = 32768
save_traces          = true
include_in_report    = false

[inference.tasks.file_audit]
temperature = 0.6
max_tokens  = 8192

[inference.tasks.cross_cutting]
temperature = 0.7
max_tokens  = 4096

[inference.tools]
enabled              = true
max_calls_per_file   = 5
max_result_tokens    = 2048
tool_timeout_seconds = 30

[inference.compaction]
enabled                  = true
trigger_pct              = 0.80
target_pct               = 0.50
preserve_recent_turns    = 2
max_compactions_per_file = 3

[inference.lifecycle]
auto_load                       = true
auto_unload                     = true
load_timeout_seconds            = 120     # auto_load subprocess timeout
load_wait_timeout_seconds       = 600     # max wait for manual load on auto_load failure (0 = disable)
load_wait_poll_interval_seconds = 5.0     # is_loaded poll cadence during wait
runlock_dir                     = ""

# [inference.ollama] — Ollama server management (only applies when
# backend = "ollama" or when Ollama is auto-detected). When manage_process=true,
# senex starts `ollama serve` at audit start and stops it when done.
# Set pull_on_start=true to automatically download missing models via `ollama pull`.
[inference.ollama]
manage_process    = false
pull_on_start     = false
startup_timeout_s = 60
base_url          = "http://localhost:11434"
model             = "gemma4:e4b"
thinking          = true
strict_json_schema = false

# [inference.sglang] — SGLang Docker container management (only applies when
# the configured base_url is served by a senex-managed SGLang stack). When
# manage_container=true, senex runs `docker compose up -d` at audit start and
# `down` at audit completion ("load on startup, shutdown on completion").
# Leave manage_container=false to keep the container running between runs
# (the default — bring it up manually via
# `bash senex/infra/sglang/sglang.sh up`).
[inference.sglang]
manage_container        = false
# compose_file            = "/path/to/your/docker-compose.yml"
# env_file                = "/path/to/your/.env"
startup_timeout_seconds = 180
via_wsl                 = true
wsl_distro              = "Ubuntu"

# [ui] — Launcher / TUI surface settings (M11).
# Drives the "Scan disk for repos" button on the Launcher screen.
[ui]
# scan_root      = "E:/code"
# scan_max_depth = 6

# Repo entries (nightly iterates these; ad-hoc may target any repo by path)
[[repos]]
name                     = "pensiv"
path                     = "E:/pensiv"
system_prompt_addendum   = ".claude/CLAUDE.md"
include_extensions       = []
exclude_globs            = ["src/pensiv/_archive/**"]
include_tests            = false
inference = { tasks = { file_audit = { temperature = 0.5 } } }
