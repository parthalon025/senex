# SGLang server configuration
# Copy this file to .env.local for machine-specific overrides (gitignored).

# Model to serve. Must be a HuggingFace model ID (not a GGUF path).
# Qwen3 family — fully supported by SGLang (reasoning + tool-call parsers):
#   Qwen/Qwen3-4B            (~8GB BF16, fastest)
#   Qwen/Qwen3-8B            (~16GB BF16, recommended quality)
#   Qwen/Qwen3-8B-AWQ        (~5GB AWQ quantized, fits with comfortable headroom)
SGLANG_MODEL=Qwen/Qwen3-8B-AWQ

# Context length. Qwen3 native: 32768 (32K). Set to 32768 for safety on 16GB.
# Increase only if you have headroom after weight + KV cache allocation.
SGLANG_CONTEXT_LENGTH=32768

# GPU memory fraction reserved for KV cache (remainder used for weights).
# 0.85 works well for E4B at Q8 on 16GB VRAM. Lower if co-running other models.
SGLANG_MEM_FRACTION=0.85

# Host port for the OpenAI-compatible API. Senex default: 30000.
SGLANG_PORT=30000

# HuggingFace access token — required for gated models (e.g., Llama 3).
# Gemma 4 E4B is ungated; leave empty unless you switch to a gated model.
HF_TOKEN=

# Restrict to a specific GPU index (0-indexed). For single-GPU setups use "0".
# CUDA expects a numeric ID list, not the literal "all" — leaving unset exposes all GPUs.
CUDA_VISIBLE_DEVICES=0
